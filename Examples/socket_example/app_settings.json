{
    "modules": [
        {
            "path": "{massir_dir}/modules",
            "type": "systems",
            "names": ["system_logger", "network_ssl", "network_socket"]
        },
        {
            "path": "{app_dir}/app",
            "type": "all",
            "names": "all"
        }
    ],

    "template": {
        "project_banner_template": "\n==========================================================\n\t{project_name} - {node_id}\n\t{project_version}\n\t{project_info}\n==========================================================\n",
    },

    "logs": {
        "show_logs": true,
        "show_banner": true,
        "hide_log_tags": [],
        "hide_log_levels": [],
        "debug_mode": true,
        "banner_color": "magenta",
        "log_color": "bright_cyan"
    },

    "information": {
        "project_name": "Socket Example",
        "project_version": "1.0.0",
        "project_info": "Multi-node distributed socket network",
        "node_id": "node1"
    },

    "network_ssl": {
        "tls_version": "1.3",
        "default_certs_path": "{app_dir}/certs",
        "verify_client_certs": true,
        "verify_server_certs": true,
        "check_hostname": false,
        "expiry_warning_days": 30,
        "auto_reload": false,
        "nodes": {
            "default": {
                "cert_file": "node1.crt",
                "key_file": "node1.key",
                "ca_file": "ca.crt"
            }
        }
    },

    "network_socket": {
        "server": {
            "default_host": "0.0.0.0",
            "default_port": 8443
        },
        "client": {
            "connect_timeout_seconds": 10.0,
            "reconnect_enabled": true,
            "reconnect_initial_delay_seconds": 2.0,
            "reconnect_max_delay_seconds": 30.0,
            "reconnect_backoff_multiplier": 2.0,
            "reconnect_max_attempts": 0,
            "send_queue_size": 1000
        },
        "framing": {
            "max_message_size_bytes": 16777216,
            "length_prefix_bytes": 4,
            "default_codec": "json"
        },
        "heartbeat": {
            "enabled": true,
            "interval_seconds": 10.0,
            "timeout_seconds": 30.0,
            "missed_threshold": 3
        },
        "pool": {
            "max_connections_per_peer": 3,
            "idle_timeout_seconds": 300.0,
            "cleanup_interval_seconds": 60.0
        }
    },

    "socket_node": {
        "node_id": "node1",
        "listen_host": "0.0.0.0",
        "listen_port": 8443,
        "advertise_host": "localhost",
        "peers": [],
        "use_tls": true,
        "auto_connect_on_start": true,
        "auto_start_server": true
    },

    "message_demo": {
        "enabled": true,
        "auto_broadcast_on_start": true,
        "broadcast_interval_seconds": 5.0,
        "broadcast_message": "Hello from {node_id}!"
    },

    "stream_demo": {
        "enabled": true,
        "auto_send_on_start": false,
        "target_peer": "",
        "test_file_path": "{app_dir}/test_data.bin",
        "chunk_size_bytes": 8192
    }
}
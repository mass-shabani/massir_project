{
    "modules": [
        {
            "path": "{massir_dir}/modules",
            "type": "systems",
            "names": ["system_logger", "network_ssl", "network_socket"]
        },
        {
            "path": "{app_dir}/app",
            "type": "all",
            "names": "all"
        }
    ],

    "template": {
        "project_banner_template": "\n==========================================================\n\tSocket Example - NODE 1\n\t1.0.0\n\tMulti-node distributed socket network\n==========================================================\n",
        "system_log_template": "[{level}]\t{message}",
        "banner_color_code": "35",
        "system_log_color_code": "96"
    },

    "logs": {
        "show_logs": true,
        "show_banner": true,
        "debug_mode": true
    },

    "information": {
        "project_name": "Socket Example",
        "project_version": "1.0.0",
        "project_info": "Node 1 of distributed network",
        "node_id": "node1"
    },

    "network_ssl": {
        "tls_version": "1.3",
        "default_certs_path": "{app_dir}/certs",
        "verify_client_certs": true,
        "verify_server_certs": true,
        "check_hostname": false,
        "nodes": {
            "default": {
                "cert_file": "node1.crt",
                "key_file": "node1.key",
                "ca_file": "ca.crt"
            },
            "node2": {
                "cert_file": "node2.crt",
                "key_file": "node2.key",
                "ca_file": "ca.crt"
            },
            "node3": {
                "cert_file": "node3.crt",
                "key_file": "node3.key",
                "ca_file": "ca.crt"
            }
        }
    },

    "network_socket": {
        "server": {
            "default_host": "0.0.0.0",
            "default_port": 8443
        },
        "client": {
            "reconnect_enabled": true,
            "reconnect_initial_delay_seconds": 2.0,
            "reconnect_max_delay_seconds": 30.0
        },
        "heartbeat": {
            "enabled": true,
            "interval_seconds": 10.0,
            "timeout_seconds": 30.0,
            "missed_threshold": 3
        }
    },

    "socket_node": {
        "node_id": "node1",
        "listen_host": "0.0.0.0",
        "listen_port": 8443,
        "advertise_host": "node1",
        "peers": [
            {"node_id": "node2", "host": "node2", "port": 8443},
            {"node_id": "node3", "host": "node3", "port": 8443}
        ],
        "use_tls": true,
        "auto_connect_on_start": true,
        "auto_start_server": true
    },

    "message_demo": {
        "enabled": true,
        "auto_broadcast_on_start": true,
        "broadcast_interval_seconds": 5.0,
        "broadcast_message": "Hello from node1!"
    },

    "stream_demo": {
        "enabled": true,
        "auto_send_on_start": false
    }
}
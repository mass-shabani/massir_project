{
    "modules": [
        {
            "path": "{massir_dir}/modules",
            "type": "systems",
            "names": ["system_logger", "network_ssl"]
        },
        {
            "path": "{app_dir}/app",
            "type": "all",
            "names": "all"
        }
    ],
    "system": {
    "auto_shutdown": true
    },
    "template": {
        "project_banner_template": "\n==========================================================\n\t{project_name}\n\t{project_version}\n\t{project_info}\n==========================================================\n",
        "system_log_template": "[{level}]\t{message}",
"banner_color": "magenta",
    "log_color": "bright_cyan"
    },

    "logs": {
        "show_logs": true,
        "show_banner": true,
        "hide_log_tags": [],
        "hide_log_levels": [],
        "debug_mode": true
    },

    "information": {
        "project_name": "SSL Example",
        "project_version": "1.0.0",
        "project_info": "Example demonstrating network_ssl module usage"
    },

    "network_ssl": {
        "tls_version": "1.3",
        "default_certs_path": "{app_dir}/certs",
        "verify_client_certs": true,
        "verify_server_certs": true,
        "check_hostname": false,
        "expiry_warning_days": 30,
        "auto_reload": false,
        "reload_check_interval_seconds": 3600,
        "cipher_suites": "HIGH:!aNULL:!MD5:!3DES:!RC4",
        "security_options": {
            "no_compression": true,
            "no_ticket": true,
            "single_dh_use": true,
            "single_ecdh_use": true
        },
        "nodes": {
            "default": {
                "cert_file": "server.crt",
                "key_file": "server.key",
                "ca_file": "ca.crt"
            },
            "client": {
                "cert_file": "client.crt",
                "key_file": "client.key",
                "ca_file": "ca.crt"
            }
        },
        "logging": {
            "tag": "ssl",
            "log_handshakes": true,
            "log_cert_info": true
        }
    },

    "ssl_tester": {
        "run_all_tests": true,
        "output_results": true,
        "test_categories": ["cert_loading", "server_context", "client_context", "mtls", "cert_info", "validation", "integration"],
        "server_host": "127.0.0.1",
        "server_port": 8443
    },

    "ssl_demo": {
        "auto_demo_on_start": true,
        "demo_host": "127.0.0.1",
        "demo_port": 8444
    }
}
{
  "modules": [
    {
      "name": "system_modules",
      "run_at": "on_start",
      "path": "{massir_dir}/modules",
      "names": [
        "system_logger",
        "network_fastapi"
      ]
    },
    {
      "name": "app_modules",
      "run_at": "on_start",
      "path": "{app_dir}/app",
      "names": [
        "template_service",
        "server_manager",
        "main_app",
        "auth_panel"
      ]
    }
  ],
  "system": {
    "auto_shutdown": false
  },
  "template": {
    "project_banner_template": "\n==========================================================\n\t{project_name}\n\t{project_version}\n\t{project_info}\n==========================================================\n",
    "system_log_template": "{timestamp}|{level}:\t\b{tag} > {message}"
  },
  "logs": {
    "show_logs": true,
    "show_banner": true,
    "hide_log_tags": [],
    "hide_log_levels": [],
    "debug_mode": true,
    "show_critical_levels": 3,
    "banner_color": "green",
    "log_color": "default",
    "print_color": "default"
  },
  "information": {
    "project_name": "Basic Website",
    "project_version": "1.0.0",
    "project_info": "A simple website built with Massir framework"
  },
  "fastapi_provider": {
    "title": "Basic Website",
    "version": "1.0.0",
    "description": "A simple website built with Massir framework",
    "docs_url": "/docs",
    "redoc_url": "/redoc",
    "openapi_url": "/openapi.json",
    "debug": false,
    "web": {
      "host": "127.0.0.1",
      "port": 8080,
      "reload": false,
      "workers": 1,
      "log_level": "info"
    },
    "cors": {
      "origins": ["*"],
      "credentials": true,
      "methods": ["*"],
      "headers": ["*"]
    },
    "gzip": {
      "enabled": true,
      "minimum_size": 1000
    },
    "trusted_hosts": ["*"]
  }
}

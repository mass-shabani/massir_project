{
    "modules": [
        {
            "path": "{massir_dir}/modules",
            "type": "systems",
            "names": ["system_logger", "network_ssl", "network_websocket", "system_network"]
        },
        {
            "path": "{app_dir}/app",
            "type": "all",
            "names": "all"
        }
    ],

    "template": {
        "project_banner_template": "\n╔════════════════════════════════════════════════════════════╗\n║  Network Test - NODE 4 (WebSocket Transport)             ║\n║  Version: 1.0.0                                          ║\n║  Testing system_network with websocket transport         ║\n╚════════════════════════════════════════════════════════════╝\n",
        "system_log_template": "[{level}]\t{message}",
        "banner_color_code": "34",
        "system_log_color_code": "96"
    },

    "logs": {
        "show_logs": true,
        "show_banner": true,
        "debug_mode": true
    },

    "information": {
        "project_name": "Network Test",
        "project_version": "1.0.0",
        "project_info": "Node 4 - WebSocket Transport",
        "node_id": "node4"
    },

    "test_config": {
        "test_duration_seconds": 60,
        "warmup_seconds": 10,
        "test_interval_seconds": 5
    },

    "network_ssl": {
        "tls_version": "1.3",
        "default_certs_path": "{app_dir}/certs",
        "verify_client_certs": true,
        "verify_server_certs": true,
        "check_hostname": false,
        "nodes": {
            "default": {
                "cert_file": "node4.crt",
                "key_file": "node4.key",
                "ca_file": "ca.crt"
            }
        }
    },

    "network_websocket": {
        "server": {
            "default_host": "0.0.0.0",
            "default_port": 8444,
            "default_path": "/ws",
            "compression_enabled": true
        },
        "client": {
            "reconnect_enabled": true,
            "default_path": "/ws",
            "subprotocol": "massir.v1",
            "compression_enabled": true
        },
        "heartbeat": {
            "enabled": true,
            "interval_seconds": 20.0,
            "timeout_seconds": 60.0
        }
    },

    "system_network": {
        "self_node": {
            "node_id": "node4",
            "metadata": {
                "role": "cloud",
                "region": "external",
                "test_node": true,
                "transport": "websocket"
            },
            "capabilities": ["gateway", "external"]
        },
        "topology": {
            "type": "mesh"
        },
        "nodes": [
            {
                "node_id": "node1",
                "transport": "socket",
                "endpoint": {
                    "host": "192.168.1.101",
                    "port": 8443,
                    "use_tls": true
                },
                "capabilities": ["storage", "compute", "gateway"]
            },
            {
                "node_id": "node2",
                "transport": "socket",
                "endpoint": {
                    "host": "192.168.1.102",
                    "port": 8443,
                    "use_tls": true
                },
                "capabilities": ["compute"]
            },
            {
                "node_id": "node3",
                "transport": "socket",
                "endpoint": {
                    "host": "192.168.1.103",
                    "port": 8443,
                    "use_tls": true
                },
                "capabilities": ["compute", "analytics"]
            }
        ],
        "routing": {
            "default_ttl": 10,
            "enable_multi_hop": true
        },
        "connection": {
            "auto_connect_on_start": true
        }
    },

    "network_tester": {
        "enabled": true,
        "run_tests": true
    },

    "network_reporter": {
        "enabled": true,
        "show_report_on_shutdown": true
    }
}

{
  "modules": [
    {
      "name": "system_modules",
      "run_at": "on_start",
      "path": "{massir_dir}/modules",
      "names": [
        "system_logger"
      ]
    },
    {
      "name": "app_modules",
      "run_at": "on_start",
      "path": "{app_dir}/app",
      "names": [
        "module1",
        "module2",
        "module3"
      ]
    }
  ],
  "system": {
    "auto_shutdown": true
  },
  "template": {
    "project_banner_template": "\n==========================================================\n\t{project_name}\n\t{project_version}\n\t{project_info}\n==========================================================\n"
  },
  "logs": {
    "show_logs": true,
    "show_banner": true,
    "hide_log_tags": [],
    "hide_log_levels": [],
    "debug_mode": true,
    "show_critical_levels": 3,
    "banner_color": "green",
    "log_color": "default"
  },
  "information": {
    "project_name": "Module Loading Order Example",
    "project_version": "1.0.0",
    "project_info": "Example demonstrating the loading order of three application modules."
  },
  "fastapi_provider": {
    "web": {
      "host": "127.0.0.1",
      "port": 8000,
      "reload": false
    }
  }
}
